# Neo4j Enterprise Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graph_saas_secure_password
NEO4J_DATABASE=neo4j

# Authentication & IdP (Auth0 / Clerk / NextAuth JWKS)
AUTH_JWKS_URL=https://auth.yourdomain.com/.well-known/jwks.json
AUTH_ISSUER=https://auth.yourdomain.com/
AUTH_AUDIENCE=https://api.yourdomain.com/graph-saas

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Environment
NODE_ENV=development
DEV_MOCK_AUTH=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
